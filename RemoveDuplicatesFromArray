import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
    public static void main(String[] args) throws java.lang.Exception
    {
        String[] str = {
            "A",
            "B",
            "A",
            "C",
            "A",
            "D",
            "C",
            "E"
        };


        int len = str.length;
        int count = 0;
        for (int i = 0; i < len; i++) {
            if (str[i].equals("0")) continue;
            for (int j = 0; j < len; j++) {

                if (i != j && str[i].equals(str[j])) {
                    str[j] = "0";
                    count++;
                }
            }
        }
        String[] newStr = new String[len - count];
        int k=0;
        for (int i = 0; i < len; i++) {
            if (!str[i].equals("0")) {
                newStr[k] =str[i];
                k++;
                
            }
        }
        System.out.print("{ ");
        for(String s : newStr){
            
            System.out.print(s+" ");
            
        }
        System.out.print("}");
    }
}



